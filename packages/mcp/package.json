{
  "name": "@datafund/agent-data-exchange",
  "version": "0.2.13",
  "description": "Unified MCP server for the Datafund Skill Exchange — identity, signing, escrow, marketplace",
  "main": "dist/index.js",
  "bin": {
    "agent-data-exchange": "./bin/agent-data-exchange.js"
  },
  "scripts": {
